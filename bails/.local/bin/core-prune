#!/bin/bash

DATA_DIR=${DATA_DIR:-/live/persistence/TailsData_unlocked/Persistent/.bitcoin}
STATE_DIR=${STATE_DIR:-/live/persistence/TailsData_unlocked/dotfiles/.local/state}
TEMPLATE=${TEMPLATE:-/live/persistence/TailsData_unlocked/dotfiles/.bitcoin/bitcoin.conf}

disk_room() {
    local free blocks
    free=$(df --output=avail "$DATA_DIR" | tail -1)
    blocks=$(du --summarize "$DATA_DIR/blocks" 2>/dev/null | cut -f1)
    echo $(( (free + ${blocks:-0}) / 1024 ))
}

chainstate_mib() {
    local mib
    mib=$(du --summarize --block-size=1M "$DATA_DIR/chainstate" 2>/dev/null | cut -f1)
    echo "${mib:-0}"
}

chainstate_growth() {
    local gb growth
    gb=$(sed -n 's/^chain_state_gb=\([0-9][0-9]*\)$/\1/p' "$STATE_DIR/core-assumed-sizes" 2>/dev/null)
    [ -n "$gb" ] || return 1
    growth=$(( gb * 1000000000 / 1048576 - $(chainstate_mib) ))
    echo $(( growth > 0 ? growth : 0 ))
}

block_room() { echo $(( $(disk_room) - $(chainstate_growth || echo 0) )); }

template_prune() {
    local prune
    prune=$(sed -n '/^\[/q; s/^prune=\([0-9]*\)$/\1/p' "$TEMPLATE" 2>/dev/null | head -1)
    echo "${prune:-0}"
}

# Core's Options window saves prune to settings.json, which overrides bitcoin.conf.
effective_prune() {
    python3 -c 'import json, sys; print(int(json.load(open(sys.argv[1]))["prune"]))' \
        "$DATA_DIR/settings.json" 2>/dev/null || template_prune
}

# Prune for a rebuilt template, as install-core decides it: on only when the
# stick can't hold the whole block chain. fit_prune then sizes the target.
new_prune() {
    local gb
    gb=$(sed -n 's/^blockchain_gb=\([0-9][0-9]*\)$/\1/p' "$STATE_DIR/core-assumed-sizes" 2>/dev/null)
    if (( $(block_room) < ${gb:-0} * 1000000000 / 1048576 )); then echo 1907; else echo 0; fi
}

# True when under 10 GB is free and the effective prune setting is off,
# manual, or too high to keep 10 GiB free.
low_space() {
    local prune
    (( $(df --output=avail "$DATA_DIR" | tail -1) < 10**7 )) || return 1
    prune=$(effective_prune)
    (( prune <= 1 || prune > $(disk_room) - 10240 ))
}

set_template() {
    [ -f "$TEMPLATE" ] || return 0
    sed -i "0,/^\[/ { /^#\?$1=/d; }" "$TEMPLATE"
    sed -i "1i $1=$2" "$TEMPLATE"
}

fit_prune() {
    local prune room target
    prune=$(template_prune)
    ((prune > 1)) || return 0
    room=$(block_room)
    (( room - prune > 11264 || room - prune < 1024 )) || return 0
    (( room - prune > 11264 )) && ! chainstate_growth >/dev/null && return 0
    target=$(( room - 10240 > 1907 ? room - 10240 : 1907 ))
    ((target == prune)) || set_template prune "$target"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case ${1:-} in
        fit) fit_prune ;;
        low-space) low_space ;;
        new) new_prune ;;
        *) echo "usage: core-prune fit | low-space | new" >&2; exit 2 ;;
    esac
fi
