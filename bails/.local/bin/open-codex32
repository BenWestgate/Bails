set -euo pipefail

readonly REVISION="1938b604182b5553f4e724fd2aea814496a24cd4"
readonly DATA_HOME="${XDG_DATA_HOME:-/live/persistence/TailsData_unlocked/dotfiles/.local/share}"
readonly SOURCE_DIR="$DATA_HOME/python-codex32"
SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly SCRIPT_DIR

python_supported() {
    python3 -c 'import sys; raise SystemExit(0 if (3, 12) <= sys.version_info[:2] < (3, 14) else 1)'
}

source_is_usable() {
    [ -d "$SOURCE_DIR/.git" ] &&
        [ "$(git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null || true)" = "$REVISION" ] &&
        [ -z "$(git -C "$SOURCE_DIR" status --porcelain=v1 --untracked-files=all --ignored=matching 2>/dev/null)" ] &&
        python_supported &&
        PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" \
            python3 -P -c 'import codex32; import codex32_gui' 2>/dev/null
}

core_is_compatible() {
    local info version major

    if info="$(bitcoin-cli getnetworkinfo 2>/dev/null)"; then
        version="$(sed -n 's/.*"version":[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<< "$info")"
        [ -n "$version" ] && ((version >= 320000))
        return
    fi

    major="$(bitcoind --version 2>/dev/null | sed -n '1s/.*version v\([0-9][0-9]*\).*/\1/p')"
    [ -n "$major" ] && ((major >= 32))
}

if ! source_is_usable; then
    zenity --question --title='Install codex32?' \
        --text='CipherStick will install or repair its pinned python-codex32 graphical application.' \
        --ok-label='Install' --default-cancel || exit 0

    "$SCRIPT_DIR/install-codex32" 2>&1 | zenity --progress --pulsate --auto-close --no-cancel \
        --title='Installing codex32' \
        --text='Installing the graphical codex32 application...' || {
        zenity --error --title='codex32 installation failed' \
            --text='The graphical codex32 application could not be installed.'
        exit 1
    }
fi

if ! source_is_usable; then
    zenity --error --title='codex32 unavailable' \
        --text='The graphical codex32 application is not available.'
    exit 1
fi

if ! core_is_compatible; then
    zenity --error --title='Bitcoin Core 32 required' \
        --text='codex32 requires Bitcoin Core 32 or newer. Use CipherStick Settings → Update Bitcoin Core, then restart Bitcoin Core before opening codex32.'
    exit 1
fi

exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" python3 -P -m codex32_gui
