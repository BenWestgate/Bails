set -euo pipefail

readonly REVISION="1938b604182b5553f4e724fd2aea814496a24cd4"
readonly DATA_HOME="${XDG_DATA_HOME:-/live/persistence/TailsData_unlocked/dotfiles/.local/share}"
readonly SOURCE_DIR="$DATA_HOME/python-codex32"
readonly BITCOIN_DATA_DIR="/live/persistence/TailsData_unlocked/Persistent/.bitcoin"
readonly BITCOIN_DESKTOP="$DATA_HOME/applications/bitcoin-qt.desktop"
SCRIPT_DIR="$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")"
readonly SCRIPT_DIR

python_supported() {
    python3 -c 'import sys; raise SystemExit(0 if (3, 12) <= sys.version_info[:2] < (3, 14) else 1)'
}

# Reject a checkout whose files differ from the pinned commit, so a corrupt,
# partial or modified checkout is repaired before it runs. This guards against
# corruption and accidents, not a local attacker: anyone who can write this
# checkout can also edit these dotfiles scripts.
source_is_usable() {
    local source_status

    [ -d "$SOURCE_DIR/.git" ] &&
        [ "$(git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null || true)" = "$REVISION" ] &&
        source_status="$(git -C "$SOURCE_DIR" status --porcelain=v1 --untracked-files=all --ignored=matching 2>/dev/null)" &&
        [ -z "$source_status" ] &&
        python_supported &&
        PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" \
            python3 -P -c 'import codex32; import codex32_gui' 2>/dev/null
}

core_is_compatible() {
    local info version

    if ! info="$(bitcoin-cli -datadir="$BITCOIN_DATA_DIR" getnetworkinfo 2>/dev/null)"; then
        return 2
    fi

    version="$(sed -n 's/.*"version":[[:space:]]*\([0-9][0-9]*\).*/\1/p' <<< "$info")"
    [ -n "$version" ] || return 2
    ((version >= 320000))
}

wait_for_core() {
    local attempts="${1:-120}" core_status

    while ((attempts > 0)); do
        if core_is_compatible; then
            return 0
        else
            core_status=$?
        fi
        if ((core_status == 1)); then
            return 1
        fi
        attempts=$((attempts - 1))
        if ((attempts > 0)); then
            sleep 1
        fi
    done
    return 2
}

core_process_running() {
    # Match the full command line, so a launch through the old "wrapped
    # bitcoin-qt ..." wrapper counts as well as bitcoin-qt itself. Launchers no
    # longer pass -datadir: Core finds the persistent datadir in its config.
    pgrep -u "$(id -u)" -f -- '(^|[/[:space:]])bitcoin-qt([[:space:]]|$)' >/dev/null 2>&1
}

wait_for_running_core() {
    local attempts="${1:-120}" core_status

    while ((attempts > 0)); do
        if core_is_compatible; then
            return 0
        else
            core_status=$?
        fi
        if ((core_status == 1)); then
            return 1
        fi
        core_process_running || return 3
        attempts=$((attempts - 1))
        if ((attempts > 0)); then
            sleep 1
        fi
    done
    return 2
}

start_core() {
    [ -f "$BITCOIN_DESKTOP" ] && command -v gio >/dev/null 2>&1 || return 1
    gio launch "$BITCOIN_DESKTOP"
}

ensure_core_ready() {
    local handoff="${1:-false}" core_status

    if core_is_compatible; then
        return 0
    else
        core_status=$?
    fi

    if ((core_status == 1)); then
        return 1
    fi

    if [ "$handoff" = false ]; then
        # Give an already-starting Core a short chance to expose RPC. If it is
        # still starting after that, wait for that process instead of launching
        # a second Bitcoin Core instance.
        if wait_for_core 5; then
            return 0
        else
            core_status=$?
        fi
        if ((core_status == 1)); then
            return 1
        fi
        if core_process_running; then
            if wait_for_running_core; then
                return 0
            else
                core_status=$?
            fi
            case "$core_status" in
                1|2) return "$core_status" ;;
                3) : ;; # The managed launch exited; start it again below.
                *) return 2 ;;
            esac
        fi
        start_core || return 2
    fi

    wait_for_core
}

main() {
    local core_status handoff=false

    if [ "${1:-}" = "--install" ]; then
        handoff=true
        shift
    fi

    if (($#)); then
        printf 'usage: %s [--install]\n' "$0" >&2
        return 2
    fi

    if ! source_is_usable; then
        "$SCRIPT_DIR/install-codex32" 2>&1 | zenity --progress --pulsate --auto-close --no-cancel \
            --title='Installing codex32' \
            --text='Installing the graphical codex32 application...' || {
            zenity --error --title='codex32 installation failed' \
                --text='The graphical codex32 application could not be installed.'
            exit 1
        }
    fi

    if ! source_is_usable; then
        zenity --error --title='codex32 unavailable' \
            --text='The graphical codex32 application is not available.'
        exit 1
    fi

    if ensure_core_ready "$handoff"; then
        core_status=0
    else
        core_status=$?
    fi

    if ((core_status != 0)); then
        if ((core_status == 1)); then
            zenity --error --title='Bitcoin Core 32 required' \
                --text='codex32 requires Bitcoin Core 32 or newer. Use CipherStick Settings > Update Bitcoin Core, then restart Bitcoin Core before opening codex32.'
        else
            zenity --error --title='Bitcoin Core unavailable' \
                --text="codex32 could not reach Bitcoin Core through CipherStick's persistent data directory. Start Bitcoin Core and wait for it to finish starting, then try again."
        fi
        exit 1
    fi

    exec env PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" python3 -P -m codex32_gui
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
