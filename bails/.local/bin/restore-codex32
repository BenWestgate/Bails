set -euo pipefail

readonly DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
readonly MS32="$DATA_HOME/python-codex32-venv/bin/ms32"

if [ ! -x "$MS32" ]; then
    zenity --question --title='Install Codex32 restoration?' \
        --text='CipherStick will install the pinned python-codex32 restoration engine before opening the restore flow.' \
        --ok-label='Install' --default-cancel || exit 0

    gnome-terminal --wait --title='Installing python-codex32' --hide-menubar -- install-codex32 || {
        zenity --error --title='Codex32 installation failed' \
            --text='python-codex32 could not be installed. No recovery material was changed.'
        exit 1
    }
fi

[ -x "$MS32" ] || {
    zenity --error --title='Codex32 unavailable' --text='The pinned ms32 restoration command is not available.'
    exit 1
}

zenity --question --title='Restore Bitcoin Core wallet from Codex32?' \
    --text='The next window is the python-codex32 recovery flow. Enter recovery secrets only when it prompts you; never place them in command arguments. It can recover a complete secret or threshold share set, suggest corrections for damaged text, and initialize a Bitcoin Core wallet.' \
    --ok-label='Open Restore' --default-cancel || exit 0

exec gnome-terminal --wait --title='Restore Bitcoin Core wallet from Codex32' --hide-menubar -- \
    "$MS32" wallet --timestamp 0
