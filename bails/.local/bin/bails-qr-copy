#!/usr/bin/python3 -I
"""Keep a received PSBT available for pasting while Zenity is open."""
import subprocess
import sys
import gi

gi.require_versions({"Gtk": "3.0", "Gdk": "3.0"})
from gi.repository import Gdk, GLib, Gtk

text = sys.stdin.read(4096)
clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
clipboard.set_text(text, -1)
notice = subprocess.Popen([
    "zenity", "--info", "--title=PSBT copied", "--no-markup",
    "--text=In Bitcoin Core, select your wallet, then choose File → Load PSBT from clipboard. Keep this message open until the transaction appears.",
    "--ok-label=Done",
])

def finished():
    if notice.poll() is None:
        return True
    Gtk.main_quit()
    return False

GLib.timeout_add(100, finished)
Gtk.main()
sys.exit(0 if notice.returncode in (0, 1) else 1)
