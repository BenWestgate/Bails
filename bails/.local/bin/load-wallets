###############################################################################
# Runs at every Bitcoin Core start. Loads each wallet in the wallet directory
# that Core did not load, and marks it to load on startup. A wallet left
# closed while a pruned node syncs falls behind the blocks Core deletes, and
# Core then refuses to open it until the whole block chain is downloaded
# again. A wallet Core cannot open is reported to the user.
###############################################################################

# Print, NUL-separated, the names in listwalletdir that are not in listwallets.
unloaded_wallets() {
    python3 -c '
import json, sys
on_disk = [w["name"] for w in json.loads(sys.argv[1])["wallets"]]
loaded = set(json.loads(sys.argv[2]))
for name in on_disk:
    if name not in loaded:
        sys.stdout.write(name + "\0")
' "$1" "$2"
}

# Escape a wallet name for zenity's Pango markup.
markup() {
    sed 's/&/\&amp;/g; s/</\&lt;/g; s/>/\&gt;/g' <<<"$1"
}

main() {
    local on_disk loaded name error names it pruned=()

    on_disk="$(bitcoin-cli -rpcwait -rpcwaittimeout=300 listwalletdir)" || return 0
    loaded="$(bitcoin-cli listwallets)" || return 0
    while IFS= read -r -d '' name; do
        # Pass the name on stdin so no wallet name is read as an option.
        if ! error="$(printf '%s\n' "filename=$name" "load_on_startup=true" |
            bitcoin-cli -rpcclienttimeout=0 -stdin -named loadwallet 2>&1 >/dev/null)"; then
            [[ "$error" == *"pruned data"* ]] && pruned+=("\"$(markup "$name")\"")
        fi
    done < <(unloaded_wallets "$on_disk" "$loaded")

    ((${#pruned[@]})) || return 0
    if ((${#pruned[@]} == 1)); then
        names="wallet ${pruned[0]}. It was" it=it
    else
        printf -v names '%s, ' "${pruned[@]}"
        names="wallets ${names%, }. They were" it=they
    fi
    zenity --warning --title='Wallet cannot be opened' --width=480 \
        --icon-name=bitcoin128 \
        --text="Bitcoin Core cannot open $names closed while Bitcoin Core deleted (pruned) blocks $it still needed.\n\nYour coins are not lost. Restore from backup into a new wallet, or turn off pruning and download the block chain again.\n\nCipherStick now opens every wallet whenever Bitcoin Core starts, so your other wallets stay up to date."
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
