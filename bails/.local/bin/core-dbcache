# Set Bitcoin Core's dbcache for this computer just before Core starts.
# CipherStick moves between computers, so it is recalculated at each launch.
#
# Usage: core-dbcache DATA_DIR

data_dir=${1:?DATA_DIR}
conf="$data_dir/bitcoin.conf"
note='# Set by CipherStick at each Bitcoin Core launch to suit this computer.'

# Largest whole MiB Bitcoin Core does not warn about (ShouldWarnOversizedDbCache):
# max(450 MiB, 75% of (total RAM - 2 GiB)), with total RAM as Core reads it.
ram=$(( $(getconf _PHYS_PAGES) * $(getconf PAGE_SIZE) ))
((ram > 0)) || { echo "core-dbcache: cannot read total RAM" >&2; exit 1; }
mib=$((1024 * 1024))
reserved=$((2048 * mib))
# Divide before multiplying, exactly as Core does, so both round the same way.
# shellcheck disable=SC2017
cap=$(( ram > reserved ? (ram - reserved) / 4 * 3 : 0 ))
dbcache=$(( cap > 450 * mib ? cap / mib : 450 ))

# Keep the setting first in bitcoin.conf, before any network section.
[ -f "$conf" ] || exit 0
rest=$(grep -v -x -F -e "$note" "$conf" | grep -v -x 'dbcache=.*')
printf '%s\ndbcache=%s\n%s\n' "$note" "$dbcache" "$rest" > "$conf"
