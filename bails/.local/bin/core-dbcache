# Keep RAM-derived dbcache settings out of Persistent Storage. The persistent
# bitcoin.conf is a template; each session gets a RAM copy. While the node is
# behind, that copy adds the largest dbcache Core accepts without its warning,
# and has Core clear the behind marker once it leaves initial block download.
DATA_DIR=${DATA_DIR:-/live/persistence/TailsData_unlocked/Persistent/.bitcoin}
STATE_DIR=${STATE_DIR:-/live/persistence/TailsData_unlocked/dotfiles/.local/state}
behind="$STATE_DIR/bitcoin-core-behind"

# Behind: still marked, no blocks yet, or unused for over 14 days.
far_behind() {
    [ -e "$behind" ] || ! compgen -G "$DATA_DIR/blocks/blk*.dat" >/dev/null ||
        [ -n "$(find "$DATA_DIR/blocks" -maxdepth 0 -mtime +14)" ]
}

warning_cap() {
    local ram mib=$((1024 * 1024)) reserved cap
    ram=$(( $(getconf _PHYS_PAGES) * $(getconf PAGE_SIZE) ))
    ((ram > 0)) || { echo "core-dbcache: cannot read total RAM" >&2; return 1; }
    reserved=$((2048 * mib))
    # Divide before multiplying, exactly as Core does.
    # shellcheck disable=SC2017
    cap=$(( ram > reserved ? (ram - reserved) / 4 * 3 : 0 ))
    echo $(( cap > 450 * mib ? cap / mib : 450 ))
}

refresh() {
    local cap
    [ -d "$DATA_DIR" ] || return 1
    far_behind || { core-config refresh; return; }
    cap=$(warning_cap) || return 1
    mkdir -p "$STATE_DIR" && touch "$behind" || return 1
    # Core runs -blocknotify only after initial block download.
    core-config refresh "dbcache=$cap" "blocknotify=rm -f $behind"
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
    case ${1:-} in
        refresh) refresh ;;
        behind) far_behind ;;
        *) echo "usage: core-dbcache refresh | behind" >&2; exit 2 ;;
    esac
fi
