# copies of the Software, and to permit persons to whom the Software is
# furnished to do so, subject to the following conditions:
#
# The above copyright notice and this permission notice shall be included in
# all copies or substantial portions of the Software.
#
# THE SOFTWARE IS PROVIDED "AS IS", WITHOUT WARRANTY OF ANY KIND, EXPRESS OR
# IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY,
# FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT. IN NO EVENT SHALL THE
# AUTHORS OR COPYRIGHT HOLDERS BE LIABLE FOR ANY CLAIM, DAMAGES OR OTHER
# LIABILITY, WHETHER IN AN ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM,
# OUT OF OR IN CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN
# THE SOFTWARE.

set -u

export WAYLAND_DISPLAY=""
export DATA_DIR="/live/persistence/TailsData_unlocked/Persistent/.bitcoin"

if [ -d "$DATA_DIR/chainstate_snapshot" ]; then
    zenity --info --title='AssumeUTXO already active' \
        --text='Bitcoin Core already has a snapshot chainstate. Background validation will continue automatically.'
    exit 0
fi

if [ "${1:-}" = "--offer" ]; then
    zenity --question --title='Use an AssumeUTXO snapshot?' \
        --text='Bitcoin Core can become usable sooner by loading a compatible UTXO snapshot while full validation continues in the background.\n\nThere is no canonical snapshot download source. Only continue if you already have a snapshot from another node or trusted handoff.' \
        --ok-label='Choose Snapshot' --cancel-label='Use Normal Sync' || exit 0
    shift
fi

snapshot="${1:-}"
if [ -z "$snapshot" ]; then
    snapshot="$(zenity --file-selection --title='Choose Bitcoin Core UTXO snapshot')" || exit 0
fi

if [ ! -f "$snapshot" ]; then
    zenity --error --title='Snapshot not found' --text="The selected file does not exist:\n$snapshot"
    exit 1
fi

# The Settings action can be used after Core has been closed. Keep this wait
# bounded so the user gets an actionable error instead of an indefinite hang.
if ! chain_info="$(bitcoin-cli -rpcwait -rpcwaittimeout=30 getblockchaininfo 2>/dev/null)"; then
    zenity --error --title='Bitcoin Core is not running' \
        --text='Start Bitcoin Core and wait for it to finish starting, then choose the snapshot again.'
    exit 1
fi

snapshot_bytes="$(stat -c %s -- "$snapshot" 2>/dev/null)" || snapshot_bytes=
available_bytes="$(df -B1 --output=avail "$DATA_DIR" 2>/dev/null | tail -1 | tr -d '[:space:]')" || available_bytes=
if [[ ! "$snapshot_bytes" =~ ^[0-9]+$ || ! "$available_bytes" =~ ^[0-9]+$ ]]; then
    zenity --error --title='Unable to check free space' \
        --text='CipherStick could not verify that Persistent Storage has enough room for AssumeUTXO background validation.'
    exit 1
fi

# Sizes Bitcoin Core assumed for this chain, recorded by install-core.
assumed_sizes="/live/persistence/TailsData_unlocked/dotfiles/.local/state/core-assumed-sizes"
assumed_chain_state_gb="$(sed -n 's/^chain_state_gb=\([0-9][0-9]*\)$/\1/p' "$assumed_sizes" 2>/dev/null)"
assumed_blockchain_gb="$(sed -n 's/^blockchain_gb=\([0-9][0-9]*\)$/\1/p' "$assumed_sizes" 2>/dev/null)"
if [[ ! "$assumed_chain_state_gb" =~ ^[0-9]+$ ]]; then
    zenity --error --title='Unable to check chainstate size' \
        --text="CipherStick could not find Bitcoin Core's expected chainstate size, so it cannot check that AssumeUTXO will fit. Update Bitcoin Core from Settings, then try again."
    exit 1
fi
chain_bytes="$(sed -n 's/^[[:space:]]*"size_on_disk"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\),\{0,1\}[[:space:]]*$/\1/p' <<<"$chain_info")"
if [[ ! "$chain_bytes" =~ ^[0-9]+$ ]]; then
    zenity --error --title='Unable to check block storage' \
        --text="CipherStick could not read how much block data Bitcoin Core stores, so it cannot check that AssumeUTXO will fit."
    exit 1
fi

# blocks/ keeps growing after import: up to the prune target on a pruned node,
# or to the whole blockchain on an unpruned one.
if grep -q '"pruned"[[:space:]]*:[[:space:]]*true' <<<"$chain_info"; then
    block_limit_bytes="$(sed -n 's/^[[:space:]]*"prune_target_size"[[:space:]]*:[[:space:]]*\([0-9][0-9]*\),\{0,1\}[[:space:]]*$/\1/p' <<<"$chain_info")"
    if [[ ! "$block_limit_bytes" =~ ^[0-9]+$ ]]; then
        zenity --error --title='Unable to check prune reserve' \
            --text="CipherStick could not read Bitcoin Core's current prune target, so it cannot check that AssumeUTXO will fit."
        exit 1
    fi
elif [[ "$assumed_blockchain_gb" =~ ^[0-9]+$ ]]; then
    block_limit_bytes=$((assumed_blockchain_gb * 1000000000))
else
    zenity --error --title='Unable to check block storage' \
        --text="CipherStick could not find the expected blockchain size for this unpruned node, so it cannot check that AssumeUTXO will fit. Continue with normal synchronization."
    exit 1
fi
future_block_growth=0
((block_limit_bytes > chain_bytes)) && future_block_growth=$((block_limit_bytes - chain_bytes))

# The snapshot file is packed, so the chainstate Core builds from it is
# larger. Use 1.5 times the file, or Core's own chainstate estimate if larger.
chainstate_bytes=$((snapshot_bytes * 3 / 2))
((assumed_chain_state_gb * 1000000000 > chainstate_bytes)) && chainstate_bytes=$((assumed_chain_state_gb * 1000000000))

# During background validation Bitcoin Core keeps both the snapshot chainstate
# and the historical chainstate. Reserve the snapshot chainstate, what the
# historical one still has to grow, the remaining block growth, and 2 GB of
# working headroom. Free space already excludes the current chainstate.
current_bytes="$(du -s -B1 "$DATA_DIR/chainstate" 2>/dev/null | cut -f1)"
[[ "$current_bytes" =~ ^[0-9]+$ ]] || current_bytes=0
growth_bytes=$((chainstate_bytes > current_bytes ? chainstate_bytes - current_bytes : 0))
required_bytes=$((chainstate_bytes + growth_bytes + future_block_growth + 2000000000))
# A pruned node can make room by keeping fewer blocks. Core reads a prune
# target only at startup, so restart it with a lower -prune, which outranks
# settings.json for this run. Later starts get wrapped's prune refit.
# 550 MiB is Core's minimum.
fit_mib=$(((available_bytes + chain_bytes - chainstate_bytes - growth_bytes - 2000000000) / 1048576))
old_prune=$((block_limit_bytes / 1048576))
if ((available_bytes < required_bytes && future_block_growth && fit_mib >= 550 &&
    fit_mib < old_prune)) && grep -q '"pruned"[[:space:]]*:[[:space:]]*true' <<<"$chain_info"; then
    zenity --question --title='Keep fewer blocks?' \
        --text="AssumeUTXO needs room for two chainstates while Bitcoin Core validates in the background. To make room, CipherStick will lower the prune target from $((old_prune / 1024)) GB to $((fit_mib / 1024)) GB and restart Bitcoin Core." \
        --ok-label='Lower and Restart' --cancel-label='Use Normal Sync' || exit 0
    stop-btc >/dev/null
    wrapped bitcoin-qt -min -startupnotify=chainstate-preload -prune="$fit_mib"
    if ! bitcoin-cli -rpcwait -rpcwaittimeout=600 getblockchaininfo >/dev/null 2>&1; then
        zenity --error --title='Bitcoin Core did not restart' \
            --text='The prune target was lowered, but Bitcoin Core did not finish starting. Start Bitcoin Core, then choose the snapshot again from Settings.'
        exit 1
    fi
elif ((available_bytes < required_bytes)); then
    missing_gb=$(((required_bytes - available_bytes + 999999999) / 1000000000))
    future_growth_gb=$(((future_block_growth + 999999999) / 1000000000))
    zenity --error --title='More Persistent Storage required' \
        --text="AssumeUTXO needs room for two chainstates and up to ${future_growth_gb} GB of additional block data. Free at least ${missing_gb} GB more, or continue with normal synchronization."
    exit 1
fi

zenity --info --title='Bitcoin Core will verify the snapshot' \
    --text='CipherStick does not trust the snapshot source. Bitcoin Core loadtxoutset accepts only snapshot hashes compiled into the installed Bitcoin Core release. Full historical validation continues in the background after the snapshot becomes active.'

loaded=0
load_output=
for ((attempt = 1; attempt <= 120; attempt++)); do
    if load_output="$(bitcoin-cli -rpcclienttimeout=0 loadtxoutset "$snapshot" 2>&1)"; then
        loaded=1
        break
    fi
    if grep -q 'must appear in the headers chain' <<<"$load_output"; then
        ((attempt == 1)) && zenity --notification \
            --text='Waiting for Bitcoin Core to download the snapshot base header.'
        sleep 5
        continue
    fi
    break
done

if ((loaded)); then
    printf '%s\n' "$load_output"
    zenity --info --title='AssumeUTXO loaded' \
        --text='The snapshot chainstate is active. Bitcoin Core will sync it toward the tip while validating the historical chain in the background.'
    if zenity --question --title='Delete snapshot file?' \
        --text='Bitcoin Core no longer needs the imported snapshot file after loadtxoutset succeeds. Delete the source file to reclaim its storage space?' \
        --ok-label='Delete Snapshot' --cancel-label='Keep Snapshot'; then
        rm -f -- "$snapshot" || zenity --error --title='Snapshot not deleted' \
            --text="CipherStick could not delete the snapshot file. Delete it in Files to reclaim the space."
    fi
    exit 0
elif grep -q 'must appear in the headers chain' <<<"$load_output"; then
    zenity --error --title='Bitcoin Core headers are still syncing' \
        --text='The snapshot base header was not available after 10 minutes. Leave Bitcoin Core running so header synchronization can continue, then try the snapshot again.'
    exit 1
else
    zenity --error --title='AssumeUTXO rejected' --no-markup \
        --text="Bitcoin Core did not load the snapshot. Normal initial block download will continue.

Bitcoin Core said: $load_output"
    exit 1
fi
