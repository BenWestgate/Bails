readonly DATA_DIR='/live/persistence/TailsData_unlocked/Persistent/.bitcoin'
readonly ICON="--window-icon=$HOME/.local/share/icons/bails128.png"

if ! bitcoin-cli -datadir="$DATA_DIR" getblockchaininfo >/dev/null 2>&1; then
    zenity --error --title='Bitcoin Core is not ready' \
        --text='Start Bitcoin Core before loading an AssumeUTXO snapshot.' "$ICON"
    exit 1
fi

snapshot=$(zenity --file-selection --title='Choose an AssumeUTXO snapshot') || exit 0
[ -n "$snapshot" ] || exit 0

zenity --question --title='Load AssumeUTXO snapshot?' "$ICON" \
    --text='Bitcoin Core will validate this snapshot against an AssumeUTXO hash built into the installed Bitcoin Core release. If the snapshot is unsupported or has been modified, Bitcoin Core will reject it.\n\nAfter a valid snapshot loads, Bitcoin Core can synchronize the snapshot chainstate toward tip while full historical validation continues in the background.' \
    --ok-label='Load Snapshot' --cancel-label='Cancel' || exit 0

if output=$(bitcoin-cli -rpcclienttimeout=0 -datadir="$DATA_DIR" loadtxoutset "$snapshot" 2>&1); then
    base_height=$(awk -F'[:,]' '/"base_height"/ { gsub(/[^0-9]/, "", $2); print $2; exit }' <<<"$output")
    zenity --info --title='AssumeUTXO snapshot loaded' "$ICON" \
        --text="Bitcoin Core accepted the snapshot${base_height:+ at height $base_height}. Background validation will continue until the snapshot is fully validated."
else
    zenity --error --title='AssumeUTXO snapshot rejected' "$ICON" \
        --text="Bitcoin Core did not accept the selected snapshot.\n\n$output"
    exit 1
fi
