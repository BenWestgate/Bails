export ICON="--window-icon=$HOME/.local/share/icons/bails128.png"

snapshot="${1:-}"
if [ -z "$snapshot" ]; then
    snapshot="$(zenity --file-selection --title='Select Bitcoin Core AssumeUTXO snapshot')" || exit 0
fi

[ -f "$snapshot" ] || {
    zenity --error --title='Snapshot not found' --text='Select an existing AssumeUTXO snapshot file.' "$ICON"
    exit 1
}

zenity --question --title='Load AssumeUTXO snapshot?' \
    --text='Bitcoin Core will accept this snapshot only if its UTXO-set hash matches a snapshot hash compiled into this Bitcoin Core release. Background validation from genesis continues after the snapshot becomes active.' \
    --ok-label='Verify and Load' --default-cancel "$ICON" || exit 0

output="$(bitcoin-cli -rpcwait -rpcclienttimeout=0 loadtxoutset "$snapshot" 2>&1)" || {
    zenity --error --title='AssumeUTXO snapshot rejected' --text="$output" --no-markup "$ICON"
    exit 1
}

zenity --info --title='AssumeUTXO snapshot loaded' \
    --text="Bitcoin Core accepted the snapshot. You can remove the snapshot file to recover its download space. Bitcoin Core will continue full background validation.\n\n$output" \
    --no-markup "$ICON"

bitcoin-cli getchainstates
