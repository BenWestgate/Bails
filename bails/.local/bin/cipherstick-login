###############################################################################
# CipherStick's login steps, run by cipherstick.desktop. They are kept apart
# from Bitcoin Core's own autostart entry, which its options can replace.
###############################################################################
BITCOIN_ADDRESS_BENEVOLENT=	# TODO: add these
BITCOIN_ADDRESS_SELFISH=	# TODO: add these
export WAYLAND_DISPLAY=""
export ICON="--window-icon=$HOME/.local/share/icons/bails128.png"
export DATA_DIR=/live/persistence/TailsData_unlocked/Persistent/.bitcoin

# shellcheck disable=SC1090
. "/home/$USER/.profile"

# CipherStick requires the Persistent Folder, GnuPG and Dotfiles. Remember if
# Persistent Folder was disabled before persistent-setup, because Core's own
# desktop autostart may already have failed against the missing data directory.
persistent_folder_was_off=''
/usr/local/lib/tpscli is-active PersistentDirectory || persistent_folder_was_off=1
persistent-setup

autostart_on() {
    local entry="$HOME/.config/autostart/bitcoin.desktop"
    [ -f "$entry" ] && ! grep -qx 'Hidden=true' "$entry"
}

# Write this session's bitcoin.conf. Core's independent login autostart may race
# this step; core-dbcache owns every restart. If Persistent Folder was off, ask
# it to replay the one Core autostart that could have failed before setup.
if [ -n "$persistent_folder_was_off" ]; then
    core-dbcache login missed-autostart || exit 1
else
    core-dbcache login || exit 1
fi
core-dbcache watch &

# At login only, run the sync helpers when Bitcoin Core is also starting.
core_starting() { autostart_on || pgrep -x bitcoin-qt >/dev/null; }

# Symlink at default datadir to our custom datadir
ln -s /live/persistence/TailsData_unlocked/Persistent/.* ~

if core_starting; then
    # Refresh the session links and start the delayed no-peer/Tor reminder.
    link-dotfiles --core-login

    # When far behind, read the chainstate into RAM while Core starts and finds
    # peers. Manual Core starts later in the session never trigger a preload.
    core-dbcache far-behind && chainstate-preload &

    # Remind users without a login password to lock the screen while Core runs.
    (
        cd "$DATA_DIR" || exit 1
        if ! grep 'progress=0.999' debug.log; then
            sleep 30
            if passwd -S "$USER" | grep NP; then
                zenity --info --title='Remember to lock your screen' --text='Lock your screen before stepping away from the PC.\n\nSynchronizing Bitcoin Core may take a while...' --icon-name=system-lock-screen "$ICON" --timeout=10 &
                tails-screen-locker
            fi
        else
            sleep 200
            if passwd -S "$USER" | grep NP; then
                zenity --info --title='Remember to lock your screen' --text='Always lock your screen before stepping away from the PC.' --icon-name=system-lock-screen "$ICON" --timeout=5 &
                tails-screen-locker
            fi
        fi
    ) &>/dev/null &
fi

# Put CipherStick, Bitcoin Core and codex32 first in the dock. Keep every other
# favorite as Tails or the user set it, so renamed or replaced Tails apps need
# no change.
if favorites=$(gsettings get org.gnome.shell favorite-apps | python3 -c '
import ast
import sys

ours = ["bails.desktop", "bitcoin-qt.desktop", "io.github.benwestgate.codex32.desktop"]
current = ast.literal_eval(sys.stdin.read().removeprefix("@as "))
print([*ours, *(app for app in current if app not in ours)])
'); then
    gsettings set org.gnome.shell favorite-apps "$favorites"
fi

# Warn if prune is off and space is low
if [ "$(core-dbcache prune)" = 0 ] && (( $(df --output=avail "$DATA_DIR" | tail -1) < 10**7 )); then
    zenity --warning --title="Disk Space Low" --text='Less than 10 GB available space remains on your USB Stick.\n\nConsider enabling pruning in <b>Bitcoin Core>Settings>Options</b> to avoid running out of space.' "$ICON"
fi

if ! (( RANDOM % 20 )) && [ -z "$DONT_ASK_DONATIONS" ]; then
        # 1 out of 20 start-ups show donation message
    export DONT_ASK_DONATIONS=1 # We already asked for donations NOTE: if this doesn't work use a TEMP file.
    if (( RANDOM % 2 )); then
        # In half of the cases, display a message with benevolent incentive
        text="CipherStick needs donations to keep everybody free and safe to use Bitcoin.\n\nEvery bit helps in our fight against surveillance, censorship and confiscation!"
        bitcoin_address=$BITCOIN_ADDRESS_BENEVOLENT
    else
        # In the other half, display a message with a more selfish incentive
        text="CipherStick protects your wallet.\n\nHelp us keep your bitcoins safe!"
        bitcoin_address=$BITCOIN_ADDRESS_SELFISH
    fi
    if zenity --question --title "Make CipherStick stronger" --text "$text" --ok-label "Donate Now" --cancel-label='Later' --icon-name=bails128 "$ICON" --modal --ellipsize; then
        notify-send --icon bails128 'Opening Bitcoin Core with our donation address...' 'Thank you for making the Bitcoin network safer to use!'
        xdg-open "bitcoin:$bitcoin_address"
        exit 0
    fi
fi
