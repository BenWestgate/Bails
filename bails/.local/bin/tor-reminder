# Wait for Bitcoin Core RPC to become available after login/startup.
for _ in {1..300}; do
    bitcoin-cli -rpcclienttimeout=1 getblockchaininfo >/dev/null 2>&1 && break
    sleep 1
done

sleep 30
blockchain_info="$(bitcoin-cli -rpcclienttimeout=1 getblockchaininfo 2>/dev/null)" || exit 0
connections="$(bitcoin-cli -rpcclienttimeout=1 getconnectioncount 2>/dev/null)" || exit 0

if grep -q '"initialblockdownload": true' <<< "$blockchain_info" && ((connections == 0)); then
    notify-send --urgency=critical --icon=tor-disconnected-symbolic \
        'Connect to Tor' \
        'Bitcoin Core has no peers and cannot continue syncing. Open Tor Connection and connect to Tor.'
fi
