persistent_root="/live/persistence/TailsData_unlocked/Persistent"
training_dir="$persistent_root/.cipherstick"
verifier="$training_dir/Persistent Storage.img"
state_dir="/live/persistence/TailsData_unlocked/dotfiles/.local/state/bails"

until /usr/local/lib/tpscli is-unlocked 2>/dev/null; do sleep 2; done
mkdir -p "$training_dir" "$state_dir"

read_secret() {
    local prompt="$1"
    printf 'SETPROMPT %s:\nGETPIN\n' "$prompt" | pinentry-gnome3 2>&1 | sed -n 's/^D //p'
}

if [ ! -f "$verifier" ]; then
    zenity --info --title='Resume passphrase training' \
        --text='To continue Persistent Storage passphrase spaced-repetition across later starts, enter the same Persistent Storage passphrase twice. CipherStick will create a local LUKS2 verifier containing no wallet data.' \
        --ok-label='Continue'

    first="$(read_secret 'Enter Persistent Storage passphrase')" || exit 0
    [ -n "$first" ] || exit 0
    second="$(read_secret 'Re-enter Persistent Storage passphrase')" || exit 0
    [ "$first" = "$second" ] || {
        unset first second
        zenity --warning --title='Passphrases did not match' --text='Training was not enabled. Try again on the next start.'
        exit 1
    }

    truncate -s 32M "$verifier"
    if ! printf '%s' "$first" | /sbin/cryptsetup luksFormat --type luks2 --batch-mode --key-file - "$verifier"; then
        rm -f "$verifier"
        unset first second
        zenity --error --title='Could not enable passphrase training' --text='The local passphrase verifier could not be created.'
        exit 1
    fi
    unset first second
fi

[ -s "$state_dir/Persistent Storage.interval" ] || printf '30\n' > "$state_dir/Persistent Storage.interval"
exec spaced-repetition "$verifier"
