###############################################################################
# Tails Persistent Storage Setup Tutorial
###############################################################################

# For security reviewing this use: https://explainshell.com/ for commands that are unclear.
export XDG_STATE_HOME="/live/persistence/TailsData_unlocked/dotfiles/.local/state"
SET_UP="$XDG_STATE_HOME/tps_is_set_up"

prompt_passphrase() {
    local passphrase response

    response="$(
        printf '%s\n' \
            'SETTITLE Spaced repetition trainer' \
            'SETDESC Enter the exact Persistent Storage passphrase so CipherStick can help you memorize it.' \
            'SETPROMPT Passphrase:' \
            'SETREPEAT Confirm passphrase:' \
            'SETREPEATERROR Passphrases do not match.' \
            'GETPIN' | pinentry-gnome3
    )" || return 1

    passphrase="$(sed -n 's/^D //p' <<< "$response")"
    [ -n "$passphrase" ] || return 1

    # Assuan escapes literal percent signs in data responses.
    printf '%s' "${passphrase//%25/%}"
}

# Match the Persistent Storage frontend however Tails names its interpreter.
tps_frontend_running() {
    pgrep -u "$(id -u)" -f '[t]ps-frontend' >/dev/null 2>&1
}

# Reopen Persistent Storage if it was closed, telling the user only once.
reopen_persistent_storage() {
    tps_frontend_running && return
    tails-persistent-storage &
    [ -n "$reopen_notified" ] && return
    notify-send --icon=tails-persistent-storage "$1"
    reopen_notified=1
}

# Check if user password is already set
passwd_unset=$(passwd -S "$USER" | grep -c NP)

welcome="Thank you for choosing CipherStick, a self-custodial Bitcoin wallet and full node."
tips='You will be asked for your passphrase from time to time as spaced repetition training. Practice <i>daily at first and then at least once a week</i> to commit it to memory.

Never share, photograph, or re-use it, never give it to anyone who emails, calls, or messages you, and only type it into CipherStick where no one can see or record you. Change it right away if you suspect it is compromised. Keep any written copy out of sight and away from your CipherSticks, and destroy it once memorized.'

# Display welcome message. Locked storage means a fresh start ($SET_UP lives
# inside it), so that path greets the user in the passphrase dialog below.
[ -f $SET_UP ] || ! /usr/local/lib/tpscli is-unlocked || zenity --title='Welcome to CipherStick' --info \
    --text="$welcome\n\nDuring this initial setup process, we will guide you through the necessary steps\nto ensure a smooth experience. Let's get started!" \
    --no-wrap --ok-label='Continue' "$ICON" --icon-name=bails128

# Check for already unlocked Persistent Storage
pgrep -f spaced-repetition || if /usr/local/lib/tpscli is-unlocked; then
    # Check for existing Persistent Storage passphrase
    until [ -f $SET_UP ]; do
        existing_passphrase="$(prompt_passphrase)"
        if [ -z "$existing_passphrase" ]; then
            zenity --error --title="Error" --text="Existing Persistent Storage passphrase is required. Please provide the passphrase." "$ICON"
        else
            # Estimate passphrase entropy to see if we can proceed; word separators add no entropy
            entropy=$(keepassxc-cli estimate "${existing_passphrase// /}" | cut -f2 | tr -C -d '[:digit:]')
            if ((entropy >= 65000)); then
                break
            elif ((entropy > 50000)); then
                zenity --question --icon-name=dialog-warning --title='Warning: Weak Passphrase Detected' \
                  --text="<b>Your passphrase is too weak to protect against a state-sponsored attacker with physical access to your USB stick.</b>\n\nTails recommends choosing a long passphrase made of 5 to 7 random words.\n<a href='https://theintercept.com/2015/03/26/passphrases-can-memorize-attackers-cant-guess/'>Learn about the maths behind memorizable and secure passphrases</a>.\n\nIf a state-sponsored attacker with physical access to your device is part of your <a href='https://ssd.eff.org/module/your-security-plan'>threat model</a>, you MUST restart, delete this Persistent Storage and use a recommended passphrase.\n\nFor more information, please read the Tails security advisory on passphrase security: <a href='https://tails.net/security/argon2id/#understanding'>Understanding weak passphrases</a>\n\nBe sure to save your work before clicking 'Restart Now'." "$ICON" --ok-label='Continue' --default-cancel --cancel-label='Restart Now' && break
            else
                zenity --question --icon-name=dialog-warning --title='WARNING: Weak Passphrase Detected' \
                  --text="<b>Your passphrase is too weak to protect against attackers with physical access to your USB stick.</b>\n\nTails recommends choosing a long passphrase made of 5 to 7 random words.\n<a href='https://theintercept.com/2015/03/26/passphrases-can-memorize-attackers-cant-guess/'>Learn about the maths behind memorizable and secure passphrases</a>.\n\nWe strongly recommend you restart, delete this Persistent Storage and use a recommended passphrase.\n\nFor more information, please read the Tails security advisory on passphrase security: <a href='https://tails.net/security/argon2id/#understanding'>Understanding weak passphrases</a>\n\nBe sure to save your work before clicking 'Restart Now'." "$ICON" --ok-label='Continue Anyway' --default-cancel --cancel-label='Restart Now' && break
            fi
            systemctl reboot
        fi
    done
    unset entropy
    [ -f $SET_UP ] || if ((passwd_unset)); then
        # Change user account password to Persistent Storage passphrase for spaced repetition practice.
        printf '%s\n%s' "$existing_passphrase" "$existing_passphrase" | passwd || echo "FAILURE to change passphrase"
    fi
    unset existing_passphrase
else
    printf '\033]2;Setup the Persistent Storage\a'
    # Welcome, choose a passphrase and write it down, in one dialog
    zenity --warning --title='Welcome to CipherStick' --width=480 "$ICON" \
        --text="$welcome\n
Next, create a Persistent Storage to protect your Bitcoin data. Use a strong passphrase suggested in the Persistent Storage dialog.\n
<b>It is impossible to recover your passphrase if you forget it!</b>\n
Write it on paper, on a hard surface to avoid leaving an imprint. Seal it in an envelope, secure it in a place like a safe or your wallet, and destroy it once you know it well." \
        --ok-label='I Will Write My Passphrase Down' --icon-name=tails-persistent-storage
    # Persistent storage creation
    until /usr/local/lib/tpscli is-unlocked; do
        reopen_persistent_storage 'Click Continue to create a Persistent Storage'
        # Once the passphrase step is likely on screen, give this hint once.
        ((++waited == 12)) && notify-send --icon=bails128 'Important: Click ↻ or choose the suggested passphrase.' 'To help remember:\n\nCreate a mental image or mnemonic using the words, in order.\nIt might be a story, scenario, or sentence that you can remember and that reminds you of the particular passphrase you chose.'
        sleep 1
    done
    unset reopen_notified waited

    # Memorization help
    ((passwd_unset)) && zenity --info --title='Spaced repetition trainer' --width=480 \
        --text="Next, enter the <b>exact</b> same passphrase from Persistent Storage so CipherStick can help you memorize it.\n\n$tips" \
        --ok-label='Continue' "$ICON" && tips_shown=1
    ((passwd_unset)) && \
    until {
        passphrase="$(prompt_passphrase)" &&
            printf '%s\n%s' "$passphrase" "$passphrase" | passwd
        result=$?
        unset passphrase
        ((result == 0))
    }; do
        zenity --warning --text='No passphrase was entered.' --title="Spaced repetition trainer" \
            --ok-label='Try Again' --ellipsize
    done

fi
if ((passwd_unset)) && ! [ -f "$SET_UP" ]; then
    # Spaced repetition training loop
    spaced-repetition &

    # Display memorization tips unless the trainer introduction showed them
    ((tips_shown)) || zenity --info --title='Tips for your new passphrase' --width=480 \
        --text="$tips" --ok-label='Continue' "$ICON"
fi

# Check features of the Persistent Storage
if /usr/local/lib/tpscli is-active PersistentDirectory && \
    /usr/local/lib/tpscli is-active GnuPG && \
    /usr/local/lib/tpscli is-active Dotfiles; then
        :
else
    tps_frontend_running || tails-persistent-storage &

    # Let the Persistent Storage window appear first so the guidance opens on top of it.
    for ((wait = 0; wait < 10; wait++)); do
        tps_frontend_running && break
        sleep 1
    done
    sleep 2
    zenity --info --title='Required Persistent Storage features' --width=480 \
        --text='Turn on these required Persistent Storage features:\n\n• Persistent Folder\n• GnuPG\n• Dotfiles\n\nNetwork Connections is optional.\n\nSetup will continue automatically when the required features are enabled.' \
        --icon-name=tails-persistent-storage "$ICON" &
    feature_dialog=$!
fi
until /usr/local/lib/tpscli is-active PersistentDirectory && \
    /usr/local/lib/tpscli is-active GnuPG && \
    /usr/local/lib/tpscli is-active Dotfiles; do
    reopen_persistent_storage 'You must turn on needed features of the Persistent Storage.'
    # After 10 seconds, list the required features still off in one
    # notification. Separate zenity notifications replace each other, so
    # only the last one would stay visible.
    if ((++feature_wait == 10)); then
        missing=()
        /usr/local/lib/tpscli is-active PersistentDirectory || missing+=('• Persistent Folder')
        /usr/local/lib/tpscli is-active GnuPG || missing+=('• GnuPG')
        /usr/local/lib/tpscli is-active Dotfiles || missing+=('• Dotfiles')
        notify-send --icon=tails-persistent-storage 'Turn on these required features:' "$(printf '%s\n' "${missing[@]}")"
    fi
    sleep 1
done
[ -n "$feature_dialog" ] && kill "$feature_dialog" &>/dev/null

# Close the Persistent Storage window
pkill -u "$(id -u)" -f '[t]ps-frontend' &>/dev/null
pkill -f 'zenity --notification' &>/dev/null
mkdir -vp $XDG_STATE_HOME
touch $SET_UP
