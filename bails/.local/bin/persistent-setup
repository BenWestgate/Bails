###############################################################################
# Tails Persistent Storage prerequisite setup
###############################################################################

export XDG_STATE_HOME="/live/persistence/TailsData_unlocked/dotfiles/.local/state"
SET_UP="$XDG_STATE_HOME/tps_is_set_up"
TRAINING_READY="$XDG_STATE_HOME/passphrase_training_initialized"
persistent_storage_opened_by_setup=false
first_setup=false
[ -f "$SET_UP" ] || first_setup=true

open_persistent_storage() {
    local desktop=/usr/share/applications/org.boum.tails.PersistentStorage.desktop

    [ "$persistent_storage_opened_by_setup" = false ] || return 0
    persistent_storage_opened_by_setup=true
    if command -v gtk-abspath-launch >/dev/null 2>&1 && [ -f "$desktop" ]; then
        gtk-abspath-launch --no-dbus-ping "$desktop"
    else
        tails-persistent-storage &
    fi
}

close_persistent_storage() {
    # Close only the unprivileged Tails frontend. The root-owned backend
    # continues managing Persistent Storage after this setup handoff ends.
    pkill -u "$USER" -f '[t]ps-frontend' 2>/dev/null || :
}

required_features_active() {
    /usr/local/lib/tpscli is-active PersistentDirectory &&
        /usr/local/lib/tpscli is-active GnuPG &&
        /usr/local/lib/tpscli is-active Dotfiles
}

if [ "$first_setup" = true ]; then
    zenity --title='Welcome to CipherStick' --info \
        --text="Thank you for choosing CipherStick, a self-custodial Bitcoin wallet and full node.\n\nCipherStick needs an unlocked Tails Persistent Storage with Persistent Folder, GnuPG, and Dotfiles enabled." \
        --no-wrap --ok-label='Continue' "$ICON" --icon-name=bails128
fi

if ! /usr/local/lib/tpscli is-unlocked; then
    zenity --warning --title='Choose a strong Persistent Storage passphrase' --no-wrap "$ICON" \
        --text='Use the Tails Persistent Storage passphrase guidance. CipherStick does not score or override a passphrase accepted by Tails.' \
        --ok-label='Continue' --icon-name=tails-persistent-storage
    open_persistent_storage
    until /usr/local/lib/tpscli is-unlocked; do
        sleep 1
        if ! pgrep -u "$(id -u)" -f '[t]ps-frontend' >/dev/null 2>&1; then
            # Closing the creation window cannot complete the prerequisite.
            # Present it again instead of leaving both setup processes waiting
            # forever for an unlock that can no longer happen.
            persistent_storage_opened_by_setup=false
            open_persistent_storage
        fi
    done
fi

if ! required_features_active; then
    open_persistent_storage
    zenity --info --title='Required Persistent Storage features' \
        --text='Turn on these required Persistent Storage features:\n\n• Persistent Folder (PersistentDirectory)\n• GnuPG\n• Dotfiles\n\nNetwork Connections is optional.\n\nSetup will continue automatically when the required features are enabled. If you close Persistent Storage first, reopen it from Apps.' \
        --icon-name=tails-persistent-storage "$ICON" &
    feature_guidance_pid=$!

    until required_features_active; do
        sleep 1
    done

    kill "$feature_guidance_pid" 2>/dev/null || :
    wait "$feature_guidance_pid" 2>/dev/null || :
fi

if [ "$persistent_storage_opened_by_setup" = true ]; then
    close_persistent_storage
fi

mkdir -p "$XDG_STATE_HOME"
touch "$SET_UP"

# Storage setup is complete. Passphrase training is a separate optional entry
# point and owns its own state, prompting, and cancellation behavior. Restart
# an initialized trainer on later sessions without re-running initialization.
if [ "$first_setup" = true ] || [ -e "$TRAINING_READY" ]; then
    setup-passphrase-training &
fi
