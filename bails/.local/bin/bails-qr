#!/bin/bash
# Copyright (c) 2026 Bails contributors
# Distributed under the MIT license; see LICENSE.
set -o pipefail
umask 077
dialog() { zenity --title='Bitcoin QR' --no-markup "$@"; }
fail() { printf '%s\n' "$*" >&2; exit 1; }
for command in zenity zbarcam qr bitcoin-cli jq xdg-open timeout bails-qr-copy; do
    command -v "$command" >/dev/null || { dialog --error --text="Missing $command"; exit 1; }
done
directory=$(mktemp -d /tmp/bitcoin-qr.XXXXXXXX) || exit 1
trap 'rm -rf -- "$directory"' EXIT
rpc() { bitcoin-cli "$@"; }
show() {
    [ "$(wc -c < "$directory/data")" -le 2953 ] || fail 'Too large for one QR. Use Core file transfer with encrypted removable storage.'
    image=$(mktemp "$directory/qr.XXXXXXXX.png")
    qr --error-correction=L < "$directory/data" > "$image"
    xdg-open "$image"
}
export_wallet() {
    rpc listwallets > "$directory/wallets"
    choice=$(jq -r 'to_entries[] | .key, (.value | @json)' "$directory/wallets" | dialog --list --column=ID --column=Wallet --hide-column=1 --print-column=1) || exit 0
    wallet=$(jq -er --argjson i "$choice" '.[$i]' "$directory/wallets")
    rpc -rpcwallet="$wallet" listdescriptors false > "$directory/export"
    rpc -rpcwallet="$wallet" listlabels | jq -c '.[]' > "$directory/labels"
    while IFS= read -r label; do
        rpc -rpcwallet="$wallet" -named getaddressesbylabel label="$(printf '%s\n' "$label" | jq -r .)" | jq --argjson label "$label" 'map_values($label)'
    done < "$directory/labels" | jq -s 'add // {}' > "$directory/labels.json"
    jq -c --slurpfile labels "$directory/labels.json" '. + {labels:$labels[0]}' "$directory/export" > "$directory/data"
    show
}
import_wallet() {
    jq -e '(.wallet_name | type == "string") and ((.labels // {}) | type == "object" and all(.[]; type == "string"))' "$directory/data" >/dev/null
    jq -ce '.descriptors | select(type == "array" and length > 0)' "$directory/data" > "$directory/descriptors"
    name=$(dialog --entry --text='Choose a new watch-only wallet name.') || exit 0
    [[ -n "$name" && "$name" != *[/\\]* && "$name" != . && "$name" != .. ]] || fail 'Use a nonempty wallet name without slashes.'
    rpc -named createwallet wallet_name="$name" disable_private_keys=true blank=true >/dev/null
    rpc -rpcwallet="$name" -stdin importdescriptors < "$directory/descriptors" > "$directory/results"
    jq -e 'length > 0 and all(.success == true)' "$directory/results" >/dev/null || fail "Import incomplete. Do not use $name. Inspect it in Core."
    jq -c '(.labels // {}) | to_entries[]' "$directory/data" > "$directory/labels"
    while IFS= read -r label; do
        rpc -rpcwallet="$name" -named setlabel address="$(printf '%s\n' "$label" | jq -r .key)" label="$(printf '%s\n' "$label" | jq -r .value)"
    done < "$directory/labels"
    dialog --info --text="Imported $name. Select it in Bitcoin Core."
}
check_address() {
    address=$(jq -Rse 'select(test("^[A-Za-z0-9:?=&%._+-]+$"))' "$directory/data" | jq -r .)
    address=${address#bitcoin:}; address=${address%%\?*}
    printf '%s\n' "$address" | rpc -stdin validateaddress | jq -e '.isvalid' >/dev/null
    rpc listwallets | jq -c '.[]' > "$directory/wallets"
    [ -s "$directory/wallets" ] || fail 'Open your signing wallet in Bitcoin Core first.'
    found=false
    while IFS= read -r wallet; do
        wallet=$(printf '%s\n' "$wallet" | jq -r .)
        printf '%s\n' "$address" | rpc -rpcwallet="$wallet" -stdin getaddressinfo > "$directory/address"
        if jq -e '.ismine' "$directory/address" >/dev/null; then
            found=true
            rpc -rpcwallet="$wallet" getwalletinfo > "$directory/wallet"
            message='Signing is not confirmed. Verify the spending policy and all required keys before sending funds.'
            if jq -e '.private_keys_enabled == false' "$directory/wallet" >/dev/null; then
                message='WARNING: This watch-only wallet has no signing keys. YOU CANNOT SPEND WITH THIS WALLET ALONE. Verify the address in your offline signing wallet before sending funds.'
            fi
            dialog --warning --text="Address recognized by wallet $wallet:\n$address\n\n$message\n\nIf encrypted, ensure you have the passphrase and can unlock the wallet."
        fi
    done < "$directory/wallets"
    $found || dialog --warning --text="WARNING: Address not owned.\n$address\n\nNo open wallet recognizes this address. If it came from YOUR wallet, check carefully: your computer and Bitcoin Core may be compromised. Do not send funds."
}
while action=$(dialog --list --column=Action 'Scan QR' 'Send PSBT' 'Export Watch-Only Wallet'); do
    (
        set -e
        case "$action" in
        'Export Watch-Only Wallet') export_wallet ;;
        'Send PSBT')
            dialog --text-info --editable --title='Paste PSBT from Core; press OK to show QR' > "$directory/text" || exit 0
            tr -d '[:space:]' < "$directory/text" > "$directory/encoded"
            { cat "$directory/encoded"; printf '\n'; } | rpc -stdin decodepsbt >/dev/null
            base64 -d < "$directory/encoded" > "$directory/data"
            show ;;
        'Scan QR')
            timeout 180 zbarcam --nodbus --raw -Sdisable -Sqrcode.enable -Sbinary --oneshot > "$directory/data"
            [ -s "$directory/data" ] || exit 0
            [ "$(wc -c < "$directory/data")" -le 2953 ] || fail 'Payload exceeds one static QR.'
            if [ "$(head -c 5 "$directory/data" | base64 -w0)" = cHNidP8= ]; then
                base64 -w0 < "$directory/data" > "$directory/text"
            else
                cp "$directory/data" "$directory/text"
            fi
            if { cat "$directory/text"; printf '\n'; } | rpc -stdin decodepsbt >/dev/null 2>&1; then
                bails-qr-copy < "$directory/text"
            elif jq -e '.descriptors' "$directory/data" >/dev/null 2>&1; then import_wallet
            else check_address
            fi ;;
        esac
    ) 2> "$directory/error"
    [ "$?" -eq 0 ] || dialog --error --text="Transfer failed. $(cat "$directory/error")"
done
