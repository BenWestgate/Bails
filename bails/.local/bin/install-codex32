set -euo pipefail

readonly REPOSITORY="https://github.com/BenWestgate/python-codex32.git"
readonly REVISION="1938b604182b5553f4e724fd2aea814496a24cd4"
readonly REVISION_REF="refs/tags/bails-recovery-1938b60"
readonly DATA_HOME="${XDG_DATA_HOME:-/live/persistence/TailsData_unlocked/dotfiles/.local/share}"
readonly SOURCE_DIR="$DATA_HOME/python-codex32"

# Compare every file under the checkout with the pinned tree by content hash.
# git status trusts index flags such as assume-unchanged, so it is not used.
source_tree_clean() {
    git -C "$SOURCE_DIR" ls-tree -r -z --full-tree "$REVISION" 2>/dev/null |
        python3 -P -c '
import hashlib, os, stat, sys

root = sys.argv[1]
expected = {}
for entry in sys.stdin.buffer.read().split(b"\0"):
    if not entry:
        continue
    meta, path = entry.split(b"\t", 1)
    mode, kind, oid = meta.split(b" ")
    if kind != b"blob":
        sys.exit(1)
    expected[os.fsdecode(path)] = (mode, oid.decode())
if not expected:
    sys.exit(1)

seen = set()
for top, dirs, files in os.walk(root):
    if top == root:
        dirs[:] = [d for d in dirs if d != ".git"]
    for name in files + [d for d in dirs if os.path.islink(os.path.join(top, d))]:
        full = os.path.join(top, name)
        rel = os.path.relpath(full, root)
        if rel not in expected:
            sys.exit(1)
        mode, oid = expected[rel]
        info = os.lstat(full)
        if mode == b"120000" and stat.S_ISLNK(info.st_mode):
            data = os.fsencode(os.readlink(full))
        elif mode in (b"100644", b"100755") and stat.S_ISREG(info.st_mode):
            with open(full, "rb") as f:
                data = f.read()
        else:
            sys.exit(1)
        if hashlib.sha1(b"blob %d\0" % len(data) + data).hexdigest() != oid:
            sys.exit(1)
        seen.add(rel)
sys.exit(0 if seen == set(expected) else 1)
' "$SOURCE_DIR"
}

python3 -c 'import sys; raise SystemExit(0 if (3, 12) <= sys.version_info[:2] < (3, 14) else 1)' || {
    echo "python-codex32 requires Python 3.12 or 3.13." >&2
    exit 1
}

python3 -c 'import gi; gi.require_version("Gtk", "4.0"); gi.require_version("Adw", "1"); from gi.repository import Adw, Gtk' || {
    echo "python-codex32 requires the GTK 4 and libadwaita packages included with Tails 7." >&2
    exit 1
}

if [ -d "$SOURCE_DIR/.git" ] && \
    [ "$(git -C "$SOURCE_DIR" rev-parse HEAD 2>/dev/null || true)" = "$REVISION" ] && \
    source_tree_clean && \
    PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" \
        python3 -P -c 'import codex32; import codex32_gui' 2>/dev/null; then
    exit 0
fi

if [ -e "$SOURCE_DIR" ] && [ ! -d "$SOURCE_DIR/.git" ]; then
    echo "$SOURCE_DIR exists but is not a git checkout." >&2
    exit 1
fi

if [ ! -d "$SOURCE_DIR/.git" ]; then
    git clone --filter=blob:none --no-checkout "$REPOSITORY" "$SOURCE_DIR"
fi

# A corrupt index makes fetch and checkout fail; checkout --force rebuilds it.
rm -f -- "$SOURCE_DIR/.git/index"
git -C "$SOURCE_DIR" fetch --depth=1 origin "$REVISION_REF"
git -C "$SOURCE_DIR" checkout --detach --force "$REVISION"
git -C "$SOURCE_DIR" clean -ffdx

actual_revision="$(git -C "$SOURCE_DIR" rev-parse HEAD)"
[ "$actual_revision" = "$REVISION" ] || {
    echo "python-codex32 revision verification failed." >&2
    exit 1
}

source_tree_clean || {
    echo "python-codex32 source-tree verification failed." >&2
    exit 1
}

PYTHONDONTWRITEBYTECODE=1 PYTHONPATH="$SOURCE_DIR/src" \
    python3 -P -c 'import codex32; import codex32_gui'
