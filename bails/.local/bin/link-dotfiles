# Set environment variables
# shellcheck source=/dev/null
. ~/.profile
export DOTFILES=/live/persistence/TailsData_unlocked/dotfiles
cd "$DOTFILES" || { persistent-setup; link-dotfiles "$@"; exit 1; } # Run persistent-setup again if off.
set -o pipefail
find . -type d -print0 | while IFS= read -r -d '' dir; do
    mkdir --parents "$HOME${dir:1}" || exit 1
done || exit 1
find . -type f -print0 | while IFS= read -r -d '' file; do
    ln --symbolic --force "$PWD${file:1}" "$HOME${file:1}" || exit 1
done || exit 1

# Bitcoin Core invokes link-dotfiles through -startupnotify once startup has
# completed. Over Tor, finding the first peer often takes a minute or two, so
# only remind the user that Tails may still be waiting for them to connect to
# Tor if Core has had no peers for the whole grace period. Stop watching as
# soon as a peer connects or Core stops answering. Other calls only refresh
# dotfile links and must not start duplicate reminder timers.
if [ "${1:-}" = "--core-startup" ]; then
    (
        grace=180 interval=15
        for ((waited = 0; waited < grace; waited += interval)); do
            sleep "$interval"
            network_info="$(bitcoin-cli getnetworkinfo 2>/dev/null)" || exit 0
            connections="$(awk '/^[[:space:]]*"connections":/ { gsub(/[^0-9]/, "", $2); print $2; exit }' <<<"$network_info")"
            [[ "$connections" =~ ^[0-9]+$ ]] && ((connections == 0)) || exit 0
        done
        if zenity --question --title='Bitcoin Core has no peers' \
            --icon-name=tor-disconnected-symbolic \
            --text='Bitcoin Core still has no peers. If Tails is waiting for you to connect to Tor, open Tor Connection now.' \
            --ok-label='Open Tor Connection' --cancel-label='Not Now'; then
            gtk-launch tca
        fi
    ) &
fi
