# Set environment variables
# shellcheck source=/dev/null
. ~/.profile
export DOTFILES=/live/persistence/TailsData_unlocked/dotfiles
cd "$DOTFILES" || { persistent-setup; link-dotfiles "$@"; exit 1; } # Run persistent-setup again if off.
find . -type d | while read -r dir; do mkdir --parents "$HOME${dir:1}"; done
find . -type f | while read -r file; do ln --symbolic --force "$PWD${file:1}" "$HOME${file:1}"; done

open_tor_connection() {
    local desktop=/usr/share/applications/tca.desktop

    if command -v gtk-abspath-launch >/dev/null 2>&1 && [ -f "$desktop" ]; then
        gtk-abspath-launch --no-dbus-ping "$desktop"
    else
        gio launch "$desktop"
    fi
}

# Bitcoin Core invokes link-dotfiles through -startupnotify once startup has
# completed. If Tails still has not bootstrapped Tor after 30 seconds, remind
# the user to connect. Other calls only refresh dotfile links and must not start
# duplicate reminder timers.
if [ "${1:-}" = "--core-startup" ]; then
    (
        sleep 30
        systemctl --quiet is-active tails-tor-has-bootstrapped.target && exit 0
        if zenity --question --title='Connect Tails to Tor' \
            --icon-name=tor-disconnected-symbolic \
            --text='Tails is not connected to Tor yet. Open Tor Connection now?' \
            --ok-label='Open Tor Connection' --cancel-label='Not Now'; then
            open_tor_connection
        fi
    ) &
fi
