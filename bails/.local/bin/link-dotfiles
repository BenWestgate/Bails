# Set environment variables
# shellcheck source=/dev/null
. ~/.profile
export DOTFILES=/live/persistence/TailsData_unlocked/dotfiles
cd "$DOTFILES" || { persistent-setup; link-dotfiles "$@"; exit 1; } # Run persistent-setup again if off.
find . -type d | while read -r dir; do mkdir --parents "$HOME${dir:1}"; done
find . -type f | while read -r file; do
    case $file in
        # Keep this session's bitcoin.conf, which core-dbcache writes in RAM.
        ./.bitcoin/bitcoin.conf)
            [ -e ~/.bitcoin/bitcoin.conf ] &&
                [ "$(readlink ~/.bitcoin/bitcoin.conf)" != "$PWD${file:1}" ] && continue ;;
    esac
    ln --symbolic --force "$PWD${file:1}" "$HOME${file:1}"
done

# cipherstick calls this once after starting Bitcoin Core at login.
# Over Tor, finding the first peer often takes a minute or two, so remind the
# user that Tails may still be waiting for them to connect to Tor only if Core
# has had no peers for the whole grace period. Other calls only refresh links.
if [ "${1:-}" = "--core-login" ]; then
    (
        # Wait for Core's RPC interface, however long Core takes to start,
        # before starting the no-peer grace period.
        until network_info="$(bitcoin-cli getnetworkinfo 2>/dev/null)"; do
            sleep 1
            pgrep -x bitcoin-qt >/dev/null || exit 0
        done

        grace=180 interval=15
        for ((waited = 0; waited < grace; waited += interval)); do
            connections="$(awk '/^[[:space:]]*"connections":/ { gsub(/[^0-9]/, "", $2); print $2; exit }' <<<"$network_info")"
            [[ "$connections" =~ ^[0-9]+$ ]] && ((connections == 0)) || exit 0
            sleep "$interval"
            network_info="$(bitcoin-cli getnetworkinfo 2>/dev/null)" || exit 0
        done
        if zenity --question --title='Bitcoin Core has no peers' \
            --icon-name=tor-disconnected-symbolic \
            --text='Bitcoin Core still has no peers. If Tails is waiting for you to connect to Tor, open Tor Connection now.' \
            --ok-label='Open Tor Connection' --cancel-label='Not Now'; then
            gtk-launch tca
        fi
    ) &
fi
