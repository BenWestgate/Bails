###############################################################################
# Login steps and Bitcoin Core start for CipherSticks and CryoSticks, run by
# cipherstick.desktop, the only CipherStick autostart.
###############################################################################
BITCOIN_ADDRESS_BENEVOLENT=bc1qtp5zkexpz5etahs3367vmg7yvtvjzyge4yepnl
BITCOIN_ADDRESS_SELFISH=bc1qtp5zkexpz5etahs3367vmg7yvtvjzyge4yepnl
export WAYLAND_DISPLAY=""
export ICON="--window-icon=$HOME/.local/share/icons/bails128.png"
export DATA_DIR=/live/persistence/TailsData_unlocked/Persistent/.bitcoin

# shellcheck disable=SC1090
. "/home/$USER/.profile"
# A CryoStick stays offline, so skip the Tor and preload steps there.
if cryostick; then
    cryo=1
elif (($? == 2)); then
    exit 0 # Tails is shutting down; don't start Core.
fi
persistent-setup || exit 1 # Checks needed persistent features are on.

# Prepare the session-only config before Core starts.
core-dbcache refresh || exit 1
setsid -f bitcoin-qt -min -chain=main -datadir="$DATA_DIR" >/dev/null 2>&1

# Symlink at default datadir to our custom datadir
ln -s /live/persistence/TailsData_unlocked/Persistent/.* ~

if [ -n "${cryo:-}" ]; then
    link-dotfiles
else
    # Refresh the session links and start the delayed no-peer/Tor reminder.
    link-dotfiles --core-login
    # When far behind, read the chainstate into RAM once per session.
    core-dbcache behind && chainstate-preload &
fi

# Remind users without a login password to lock the screen while Core runs.
(
    delay=30 timeout=10 text='Lock your screen before stepping away from the PC.\n\nSynchronizing Bitcoin Core may take a while...'
    grep -q 'progress=0.999' "$DATA_DIR/debug.log" &&
        delay=200 timeout=5 text='Always lock your screen before stepping away from the PC.'
    sleep "$delay"
    passwd -S "$USER" | grep -q NP || exit 0
    zenity --info --title='Remember to lock your screen' --text="$text" --icon-name=system-lock-screen "$ICON" --timeout="$timeout" &
    tails-screen-locker
) &>/dev/null &

# Put CipherStick, Bitcoin Core and codex32 first in the dock. Keep every other
# favorite as Tails or the user set it, so renamed or replaced Tails apps need
# no change.
if favorites=$(gsettings get org.gnome.shell favorite-apps | python3 -c '
import ast
import sys

ours = ["bails.desktop", "bitcoin-qt.desktop", "io.github.benwestgate.codex32.desktop"]
current = ast.literal_eval(sys.stdin.read().removeprefix("@as "))
print([*ours, *(app for app in current if app not in ours)])
'); then
    gsettings set org.gnome.shell favorite-apps "$favorites"
fi

# Warn if space is low and pruning is off or set too high
if core-prune low-space; then
    zenity --warning --title="Disk Space Low" --text='Less than 10 GB available space remains on your USB Stick.\n\nConsider enabling pruning or lowering its target in <b>Bitcoin Core>Settings>Options</b> to avoid running out of space.' "$ICON"
fi

if ! (( RANDOM % 20 )) && [ -z "$DONT_ASK_DONATIONS" ]; then
        # 1 out of 20 start-ups show donation message
    export DONT_ASK_DONATIONS=1 # We already asked for donations NOTE: if this doesn't work use a TEMP file.
    if (( RANDOM % 2 )); then
        # In half of the cases, display a message with benevolent incentive
        text="CipherStick needs donations to keep everybody free and safe to use Bitcoin.\n\nEvery bit helps in our fight against surveillance, censorship and confiscation!"
        bitcoin_address=$BITCOIN_ADDRESS_BENEVOLENT
    else
        # In the other half, display a message with a more selfish incentive
        text="CipherStick protects your wallet.\n\nHelp us keep your bitcoins safe!"
        bitcoin_address=$BITCOIN_ADDRESS_SELFISH
    fi
    if zenity --question --title "Make CipherStick stronger" --text "$text" --ok-label "Donate Now" --cancel-label='Later' --icon-name=bails128 "$ICON" --modal --ellipsize; then
        notify-send --icon bails128 'Opening Bitcoin Core with our donation address...' 'Thank you for making the Bitcoin network safer to use!'
        xdg-open "bitcoin:$bitcoin_address"
        exit 0
    fi
fi
